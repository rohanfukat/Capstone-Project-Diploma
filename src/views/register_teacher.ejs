<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8">
    <title> Teacher Registration Form </title>
    <link rel="stylesheet" href="style.css">
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
   </head>
<body>
  <div class="container">
    <div class="title">Teacher Registration</div>
    <div class="content">
      <form action="/register_teacher" method="post" id = "teacher_form">
        <div class="user-details">
          <div class="input-box">
            <span class="details"></span> 
            <input type="text" placeholder="name" name ="teacher_name" required>
          </div>
          <div class="input-box">
            <span class="details"></span>
            <input type="text" placeholder="Create your ID" name="teacher_id" required oninput="this.value=value.replace(/[^0-9]/g,'');">
          </div>
           <div class="input-box">
            <span class="details"></span>
            <input type="text" placeholder="phone number " name="teacher_no" id="phonenumber" required oninput="this.value=value.replace(/[^0-9]/g,'');">
          </div>
 <div class="input-box">
            <span class="details"></span>
            <input type="email" placeholder="e-mail" name="teacher_stud" required>
          </div>
          <div class="input-box">
            <span class="details"></span>
            <input type="text" placeholder="password"  name="teacher_password" required>
          </div>
          <div class="input-box">
            <span class="details"></span>
            <input type="text" id="confirm password" placeholder="confirm password" required>
          </div>
          <!-- <div class="input-box">
            <span class="details"></span>
            <input type="text" id="phonenumber" placeholder="semester" required oninput="this.value=value.replace(/[^0-9]/g,'');">
          </div> -->
          <!-- <div class="input-box">
            <span class="details"></span>
            <input type="text" placeholder="enrollment number" required oninput="this.value=value.replace(/[^0-9]/g,'');">
          </div> -->
          <!-- <div class="input-box">
            <span class="details"></span>
            <input type="text" placeholder="password" required>
          </div>
          <div class="input-box">
            <span class="details"></span>
            <input type="text" placeholder="confirm password" required>
          </div> -->
        </div>
        <div class="gender-details">
          <input type="radio" name="gender" id="dot-1">
          <input type="radio" name="gender" id="dot-2">
          <input type="radio" name="gender" id="dot-3">
          
          <div class="category">
            <label for="dot-1">
          
          </div>
        </div>
        <div class="button">
          <input type="submit" value="Register" onclick="phonevalidate()">
        </div>
      </form>
    </div>
  </div>

  <% if(locals.e) { %>
    <!-- <div class="alert alert-danger" role="alert"><%= e %></div> -->
    <script>
          let a = '<%=e %>';
      alert(a);
    </script>
    <% } %>
    

